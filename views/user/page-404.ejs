<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f5f5f5;
        text-align: center;
    }

    .error-container {
        max-width: 600px;
        padding: 40px;
    }

    .error-code {
        font-size: 120px;
        font-weight: bold;
        color: #333;
    }

    h1 {
        font-size: 32px;
        margin-bottom: 15px;
    }

    p {
        color: #666;
        font-size: 18px;
        margin-bottom: 25px;
    }

    .home-btn {
        display: inline-block;
        padding: 12px 25px;
        background: #333;
        color: white;
        text-decoration: none;
        border-radius: 6px;
    }

    .home-btn:hover {
        background: #555;
    }
</style>


</head>

<body>


<div class="error-container">
    <div class="error-code">404</div>

    <h1>Page Not Found</h1>

    <p>
        Sorry, the page you are looking for does not exist.
    </p>

    <a href="/" class="home-btn">Go Back Home</a>
</div>

</body>
</html>
